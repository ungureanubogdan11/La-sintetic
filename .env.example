# Copy to .env and adjust. .env is git-ignored.

# PostgreSQL (used by the postgres, migrate and api services).
# Keep the password URL-safe (letters, digits, - _ .): it is embedded in the migrate connection URL.
PG_USER=lasintetic
PG_PASSWORD=lasintetic_dev
PG_DB=lasintetic
# Where the API connects. These values are for running the API on the host (go run);
# inside Docker, compose overrides PG_HOST=postgres and PG_PORT=5432.
PG_HOST=localhost
PG_PORT=5432
PG_SSL=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h
